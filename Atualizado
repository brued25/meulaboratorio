        // --- DNA Audio Synthesizer ---
        function insertDnaPreset(seq) {
            document.getElementById('dnaInput').value = seq;
        }

        function playDanyNote(freq, duration) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = 'sine';
                osc.frequency.value = freq;
                gain.gain.setValueAtTime(0.15, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
                osc.connect(gain);
                gain.connect(ctx.destination);
                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch(e) { console.log(e); }
        }

        function playDnaSequence() {
            const seq = document.getElementById('dnaInput').value.toUpperCase().replace(/[^ATCG]/g, '');
            const vis = document.getElementById('dnaVisualizer');
            vis.innerHTML = '';
            
            const mapNotes = { 'A': 220, 'T': 277.18, 'C': 329.63, 'G': 392.00 };
            
            let delay = 0;
            for(let i=0; i<seq.length; i++) {
                const char = seq[i];
                const freq = mapNotes[char] || 440;
                
                // Visual element
                const box = document.createElement('div');
                box.className = 'w-8 h-10 rounded bg-purple-900/60 border border-purple-500/50 flex items-center justify-center font-mono text-xs text-cyan-300 font-bold';
                box.innerText = char;
                vis.appendChild(box);

                setTimeout(() => {
                    box.classList.add('bg-cyan-500/40', 'border-cyan-300');
                    playDanyNote(freq, 0.3);
                }, delay);
                delay += 250;
            }
        }

        // --- Mitosis Canvas Simulation ---
        let mitosisInterval = null;
        function startMitosis() {
            const canvas = document.getElementById('mitosisCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.offsetWidth;
            canvas.height = canvas.offsetHeight;

            let step = 0;
            const phases = ["Interfase", "Prófase (Condensação)", "Metáfase (Alinhamento)", "Anáfase (Separação)", "Telófase & Citocinese"];

            if(mitosisInterval) clearInterval(mitosisInterval);

            mitosisInterval = setInterval(() => {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                step = (step + 1) % 100;
                
                let phaseIdx = Math.floor(step / 20);
                document.getElementById('mitosisPhaseText').innerText = "Fase: " + phases[phaseIdx];

                ctx.save();
                ctx.translate(canvas.width / 2, canvas.height / 2);

                if(phaseIdx <= 1) {
                    // Single cell dividing
                    ctx.beginPath();
                    ctx.arc(0, 0, 45, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(168, 85, 247, 0.2)';
                    ctx.strokeStyle = '#A855F7';
                    ctx.lineWidth = 2;
                    ctx.fill();
                    ctx.stroke();

                    // Nucleus
                    ctx.beginPath();
                    ctx.arc(0, 0, 18, 0, Math.PI * 2);
                    ctx.fillStyle = '#10B981';
                    ctx.fill();
                } else {
                    // Two daughter cells separating
                    let offset = (step - 60) * 1.2;
                    if(offset < 0) offset = 0;
                    if(offset > 35) offset = 35;

                    // Cell 1
                    ctx.beginPath();
                    ctx.arc(-offset, 0, 35, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, 0.2)';
                    ctx.strokeStyle = '#00F0FF';
                    ctx.lineWidth = 2;
                    ctx.fill();
                    ctx.stroke();

                    // Cell 2
                    ctx.beginPath();
                    ctx.arc(offset, 0, 35, 0, Math.PI * 2);
                    ctx.fillStyle = 'rgba(0, 240, 255, 0.2)';
                    ctx.strokeStyle = '#00F0FF';
                    ctx.lineWidth = 2;
                    ctx.fill();
                    ctx.stroke();
                }

                ctx.restore();
            }, 80);
        }

        function resetMitosis() {
            if(mitosisInterval) clearInterval(mitosisInterval);
            const canvas = document.getElementById('mitosisCanvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            document.getElementById('mitosisPhaseText').innerText = "Fase: Interfase";
        }

        // Initial Load
        window.onload = function() {
            renderCards();
            updateStats();
        };
    </script>
</body>
</html>
